{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4173/InvestorBlueprint/index.html",
        "http://127.0.0.1:4173/InvestorBlueprint/pricing.html",
        "http://127.0.0.1:4173/InvestorBlueprint/login.html",
        "http://127.0.0.1:4173/InvestorBlueprint/privacy.html"
      ],
      "startServerCommand": "python3 -u -m http.server 4173 --bind 127.0.0.1 --directory ..",
      "startServerReadyPattern": "Serving HTTP on",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless --no-sandbox --disable-setuid-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.7
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
